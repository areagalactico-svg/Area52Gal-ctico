# ============================================
# Variables de entorno — Área 52 UNI
# Local: copia este archivo a .env (nunca lo commitees).
# Vercel: Settings → Environment Variables (marca Production,
# Preview y Development) y haz Redeploy.
# ============================================

# Requerida: IA con OpenRouter (simulacros, guías, test vocacional, tutor, chatbot)
# Consíguela en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Opcional: Modelo de OpenRouter a utilizar (por defecto: deepseek/deepseek-chat)
# Ejemplos: deepseek/deepseek-chat, google/gemini-2.0-flash-001, openai/gpt-4o-mini, meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=deepseek/deepseek-chat

# Requerida: URL de tu proyecto Supabase
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://tnqjjydmlruzcxlzeurt.supabase.co

# Opcional pero RECOMENDADA: service_role (solo servidor, jamás al cliente)
# Supabase → Project Settings → API Keys → service_role (secret)
# Sin ella NO se guardan: banco de preguntas, vistas por estudiante,
# hallazgos de agentes ni guías personalizadas (todo lo demás sigue funcionando).
SUPABASE_SERVICE_KEY=eyJhbGciOi...

# Opcional: anon key (ya tiene fallback público en el código; solo
# configúrala si rotas las keys de Supabase)
# SUPABASE_ANON_KEY=eyJhbGciOi...
