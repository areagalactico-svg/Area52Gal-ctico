{
  "name": "area52-uni",
  "version": "1.0.0",
  "description": "Sitio web oficial de Área 52 UNI - Centro de Asesoría y Preparación Académica",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "build": "echo 'Build complete'",
    "start": "node server.js",
    "deploy": "vercel",
    "agents:collect": "node agents/run-collect.js --uni=ALL",
    "agents:collect:uni": "node agents/run-collect.js --uni=UNI --save",
    "agents:guide:test": "node -e \"console.log('Usa POST /api/generate-guide con estudiante+resultado')\""
  },
  "keywords": [
    "UNI",
    "preparación académica",
    "tutorías",
    "preuniversitario"
  ],
  "author": "Área 52 UNI",
  "license": "MIT",
  "devDependencies": {
    "http-server": "^14.1.1"
  }
}
